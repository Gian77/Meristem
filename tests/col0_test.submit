########################################################################
# Arabidopsis Col-0 end-to-end test of Meristem on HTCondor.
#
# Col-0 has an expert reference annotation (Araport11-based TAIR10 GFF3 in
# databases/test_col0/), so this run can be scored for accuracy, not only
# BUSCO completeness. Rerun it after changing the workflow.
#
# Submit from the Meristem folder: condor_submit tests/col0_test.submit
# For a fresh test, change RUN_NAME (e.g. to a new date). NEW_RUN=true starts
# a new session only when none exists for OUTDIR and WORKDIR; a restart after
# an eviction resumes this run's own session.
########################################################################

PROJECT_DIR = /mnt/cephfs/linuxhome/benucci/Meristem
RUN_NAME = Col0-test-20261112
INPUT = $(PROJECT_DIR)/tests/data/col0.samplesheet.csv
OUTDIR = $(PROJECT_DIR)/results/$(RUN_NAME)
WORKDIR = $(PROJECT_DIR)/nf-work-$(RUN_NAME)
PROTEINS = $(PROJECT_DIR)/databases/plant_annotation/ensembl_plants_release63/processed/brassicales_reference_proteins.faa
BUSCO_DB = $(PROJECT_DIR)/databases/busco_downloads

universe       = local
executable     = $(PROJECT_DIR)/run_annotation_condor.sh
initialdir     = $(PROJECT_DIR)
getenv         = true
environment    = "INPUT=$(INPUT) OUTDIR=$(OUTDIR) WORKDIR=$(WORKDIR) PROTEINS=$(PROTEINS) BUSCO_DB=$(BUSCO_DB) BUSCO_LINEAGE=brassicales_odb10 BRAKER4_BUSCO_LINEAGE=brassicales_odb12 CLUSTER_PROTEINS=true CLUSTER_MIN_SEQ_ID=0.80 CLUSTER_COVERAGE=0.80 RUN_BRAKER4=true RUN_HELIXER=true NEW_RUN=true"
notification   = Never
output         = $(PROJECT_DIR)/condor_logs/$(RUN_NAME).stdout.txt
error          = $(PROJECT_DIR)/condor_logs/$(RUN_NAME).stderr.txt
log            = $(PROJECT_DIR)/condor_logs/$(RUN_NAME).condor.log
on_exit_remove = (ExitCode == 0) || (NumJobStarts >= 3)
on_exit_hold   = (ExitCode =!= 0) && (NumJobStarts >= 3)
queue

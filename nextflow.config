nextflow.enable.dsl=2

manifest {
    name            = 'meristem-plant-annotation'
    description     = 'Plant genome repeat annotation, BRAKER3 prediction, BUSCO and functional annotation'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}

params {
    input                   = null
    outdir                  = "results"
    proteins                = null
    busco_lineage           = "poales_odb10"
    busco_db                = null
    edta_species            = "others"
    edta_db                 = null
    repeatmasker_library    = null
    interproscan             = false
    interproscan_db          = null
    eggnog                   = false
    eggnog_db                = null
    run_repeatmasker         = true
    run_edta                 = true
    min_contig_size          = 5000
    max_cpus                 = 32
    max_memory               = "128.GB"
    max_time                 = "7.day"
    publish_dir_mode         = "copy"
    edta_container           = "quay.io/biocontainers/edta:2.2.2--hdfd78af_1"
    repeatmasker_container   = "quay.io/biocontainers/repeatmasker:4.1.5--pl5321hdfd78af_0"
    braker_container         = "docker.io/teambraker/braker3:v3.0.8"
    busco_container          = "quay.io/biocontainers/busco:5.8.0--pyhdfd78af_0"
    interproscan_container   = "quay.io/biocontainers/interproscan:5.75-106.0--hdfd78af_0"
    eggnog_container         = "quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_0"
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    withLabel: 'low' {
        cpus = 2
        memory = '4.GB'
        time = '4.h'
    }
    withLabel: 'repeat_discovery' {
        cpus = 16
        memory = '64.GB'
        time = '7.day'
    }
    withLabel: 'repeat_masking' {
        cpus = 16
        memory = '32.GB'
        time = '2.day'
    }
    withLabel: 'braker' {
        cpus = 16
        memory = '64.GB'
        time = '3.day'
    }
    withLabel: 'busco' {
        cpus = 8
        memory = '32.GB'
        time = '2.day'
    }
    withLabel: 'functional' {
        cpus = 16
        memory = '64.GB'
        time = '7.day'
    }
    withLabel: 'database' {
        errorStrategy = 'retry'
        maxRetries = 1
    }
    maxForks = 8
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "${projectDir}/.apptainer_cache"
    pullTimeout = '60m'
}

profiles {
    docker {
        docker.enabled = true
        process.container = null
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = null
    }
    apptainer {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/.apptainer_cache"
        process.container = null
    }
    condor {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = "${System.getenv('HOME')}/.apptainer_cache"
        apptainer.pullTimeout = '60m'
        process {
            executor = 'condor'
            // Prefer the larger Scarcity nodes for resource-heavy annotation
            // tasks, but allow another eligible node if they are unavailable.
            clusterOptions = 'requirements = Machine != "scarcity-14.glbrc.org"\nrank = (Machine == "scarcity-12.glbrc.org") * 2 + (Machine == "scarcity-9.glbrc.org")'
        }
        executor {
            queueSize = 50
            submitRateLimit = '10/1min'
        }
    }
    conda {
        conda.enabled = true
    }
    test {
        params.run_edta = false
        params.run_repeatmasker = false
        params.interproscan = false
        params.eggnog = false
    }
}

// Override with -w for dedicated scratch, as in nf-broom. The default stays
// inside the project so local runs do not need writes outside the workspace.
workDir = "${projectDir}/nf-work-meristem"

// The shared database area is an input only. No process in this pipeline is
// allowed to write there; database preparation is deliberately outside the run.

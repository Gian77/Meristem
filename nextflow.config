nextflow.enable.dsl=2

manifest {
    name            = 'meristem-plant-annotation'
    description     = 'Plant genome repeat annotation with BRAKER4 and Helixer options'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}

params {
    input                   = null
    outdir                  = "results"
    proteins                = null
    run_braker4             = true
    run_helixer             = false
    // Unmodified BRAKER4 at a pinned commit, installed by scripts/setup_braker4.sh
    braker4_source          = "${projectDir}/vendor/BRAKER4-6a5ee16"
    braker4_commit          = "6a5ee16591a0a15872aa838d9dee68e54f614ee0"
    braker4_allow_unpinned  = false
    // Used only inside BRAKER4 (compleasm); Meristem's reported BUSCO uses busco_lineage
    braker4_busco_lineage   = "poales_odb12"
    braker4_runner_container = null
    braker4_snakemake       = "${projectDir}/.snakemake-env/bin/snakemake"
    braker4_singularity_prefix = "${projectDir}/.apptainer_cache"
    braker4_singularity_args = "-B ${projectDir}"
    braker4_braker3_image   = "docker://teambraker/braker3:v3.1.1"
    braker4_min_contig      = 10000
    // Official Helixer 0.3.7 image (digest sha256:ed798e8470876a7ed237c3727bd5df40acd602ceadcb3a9c4e0bfecfca5e648e)
    helixer_container       = "docker://gglyptodon/helixer-docker:helixer_v0.3.7_cuda_12.2.2-cudnn8_1"
    helixer_lineage         = "land_plant"
    helixer_model           = "${projectDir}/helixer_models/land_plant/land_plant_v0.3_a_0080.h5"
    helixer_container_options = ""
    helixer_deterministic   = false
    cluster_proteins        = false
    cluster_min_seq_id      = 0.90
    cluster_coverage        = 0.80
    busco_lineage           = "poales_odb10"
    busco_db                = null
    edta_species            = "others"
    edta_db                 = null
    repeatmasker_library    = null
    interproscan             = false
    interproscan_db          = null
    eggnog                   = false
    eggnog_db                = null
    gene_origin_db           = null
    gene_origin_taxonomy     = null
    run_repeatmasker         = true
    run_edta                 = true
    min_contig_size          = 5000
    max_cpus                 = 48
    max_memory               = "768.GB"
    max_time                 = "7.day"
    publish_dir_mode         = "copy"
    edta_container           = "quay.io/biocontainers/edta:2.2.2--hdfd78af_1"
    repeatmasker_container   = "quay.io/biocontainers/repeatmasker:4.1.5--pl5321hdfd78af_0"
    mmseqs_container         = "quay.io/biocontainers/mmseqs2:15.6f452--pl5321h6a68c12_3"
    busco_container          = "quay.io/biocontainers/busco:5.8.0--pyhdfd78af_0"
    multiqc_container        = "quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0"
    interproscan_container   = "quay.io/biocontainers/interproscan:5.75-106.0--hdfd78af_0"
    eggnog_container         = "quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_0"
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    // Let running tasks finish after a failure so long jobs are not lost. No new
    // tasks start and the run still reports failure.
    errorStrategy = 'finish'
    withLabel: 'low' {
        cpus = 2
        memory = '4.GB'
        time = '4.h'
    }
    withLabel: 'repeat_discovery' {
        cpus = 48
        memory = '768.GB'
        time = '7.day'
    }
    withLabel: 'repeat_masking' {
        cpus = 16
        memory = '32.GB'
        time = '2.day'
    }
    withLabel: 'braker4' {
        cpus = 32
        memory = '96.GB'
        time = '7.day'
    }
    withLabel: 'helixer' {
        cpus = 16
        memory = '64.GB'
        time = '2.day'
    }
    withLabel: 'protein_clustering' {
        cpus = 16
        memory = '32.GB'
        time = '2.day'
    }
    withLabel: 'busco' {
        cpus = 8
        memory = '32.GB'
        time = '2.day'
    }
    withLabel: 'functional' {
        cpus = 16
        memory = '64.GB'
        time = '7.day'
    }
    withLabel: 'database' {
        errorStrategy = 'retry'
        maxRetries = 1
    }
    maxForks = 8
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "${projectDir}/.apptainer_cache"
    pullTimeout = '60m'
}

profiles {
    docker {
        docker.enabled = true
        process.container = null
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = null
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = "${projectDir}/.apptainer_cache"
        process {
            executor = 'local'
            container = null
        }
    }
    condor {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = "${System.getenv('HOME')}/.apptainer_cache"
        apptainer.pullTimeout = '60m'
        process {
            executor = 'condor'
            // Prefer the larger Scarcity nodes for resource-heavy annotation
            // tasks, but allow another eligible node if they are unavailable.
            clusterOptions = 'requirements = Machine != "scarcity-14.glbrc.org"\nrank = (Machine == "scarcity-12.glbrc.org") * 2 + (Machine == "scarcity-9.glbrc.org")'
        }
        executor {
            queueSize = 50
            submitRateLimit = '10/1min'
        }
    }
    conda {
        conda.enabled = true
    }
    test {
        params.input = "${projectDir}/tests/data/test.samplesheet.csv"
        params.proteins = "${projectDir}/tests/data/proteins.faa"
        params.outdir = "${projectDir}/test_results"
        params.run_edta = false
        params.repeatmasker_library = "${projectDir}/tests/data/repeats.fa"
        params.run_repeatmasker = false
        params.interproscan = false
        params.eggnog = false
        params.run_braker4 = true
        params.run_helixer = false
        params.braker4_source = "${projectDir}/tests/data/braker4_stub"
        params.braker4_snakemake = "${projectDir}/tests/data/braker4_stub/snakemake"
        params.braker4_allow_unpinned = true
        params.busco_lineage = "eukaryota_odb10"
        params.cluster_proteins = false
        params.min_contig_size = 1
        apptainer.enabled = false
        process {
            executor = 'local'
            container = null
            withLabel: 'low' { cpus = 1; memory = '2.GB'; time = '30.m' }
            withLabel: 'repeat_discovery' { cpus = 1; memory = '2.GB'; time = '30.m' }
            withLabel: 'repeat_masking' { cpus = 1; memory = '2.GB'; time = '30.m' }
            withLabel: 'braker' { cpus = 1; memory = '4.GB'; time = '30.m' }
            withLabel: 'braker4' { cpus = 1; memory = '4.GB'; time = '30.m' }
            withLabel: 'helixer' { cpus = 1; memory = '2.GB'; time = '30.m' }
            withLabel: 'protein_clustering' { cpus = 1; memory = '2.GB'; time = '30.m' }
            withLabel: 'busco' { cpus = 1; memory = '4.GB'; time = '30.m' }
            withLabel: 'functional' { cpus = 1; memory = '4.GB'; time = '30.m' }
        }
    }
}

// Override with -w for dedicated scratch, as in nf-broom. The default stays
// inside the project so local runs do not need writes outside the workspace.
workDir = "${projectDir}/nf-work-meristem"

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

dag {
   enabled = true
   file = "${params.outdir}/pipeline_info/dag.html"
   overwrite = true
}

// The shared database area is an input only. No process in this pipeline is
// allowed to write there; database preparation is deliberately outside the run.

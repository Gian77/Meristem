{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://example.org/meristem/annotation-schema.json",
  "title": "Meristem plant genome annotation",
  "type": "object",
  "properties": {
    "input": {"type": "string", "description": "CSV samplesheet with sample and assembly columns"},
    "outdir": {"type": "string", "default": "results"},
    "proteins": {"type": "string", "description": "Protein FASTA evidence"},
    "run_braker3": {"type": "boolean", "default": true, "description": "Run the existing native BRAKER3 module"},
    "run_braker4": {"type": "boolean", "default": false, "description": "Run BRAKER4 through its Snakemake workflow"},
    "run_helixer": {"type": "boolean", "default": false, "description": "Run Helixer ab initio gene prediction"},
    "braker4_source": {"type": "string", "default": "vendor/BRAKER4", "description": "Local BRAKER4 checkout containing Snakefile and rules"},
    "braker4_runner_container": {"type": "string", "description": "Optional container with Snakemake and the BRAKER4 runner dependencies"},
    "braker4_snakemake": {"type": "string", "default": ".snakemake-env/bin/snakemake", "description": "Snakemake executable used to run BRAKER4"},
    "braker4_singularity_prefix": {"type": "string", "description": "Shared cache for BRAKER4's nested Singularity containers"},
    "braker4_singularity_args": {"type": "string", "description": "Bind arguments passed to BRAKER4's nested Singularity jobs"},
    "braker4_braker3_image": {"type": "string", "default": "docker://teambraker/braker3:v3.1.1"},
    "braker4_min_contig": {"type": "integer", "default": 10000, "minimum": 0},
    "helixer_container": {"type": "string", "default": ".apptainer_cache/helixer_v0.3.7_cuda_12.2.2-cudnn8_1.sif"},
    "helixer_lineage": {"type": "string", "default": "land_plant"},
    "helixer_model": {"type": "string", "default": "helixer_models/land_plant/land_plant_v0.3_a_0080.h5", "description": "Local Helixer HDF5 model path"},
    "helixer_container_options": {"type": "string", "description": "Optional Apptainer options, e.g. --nv for GPU inference"},
    "helixer_deterministic": {"type": "boolean", "default": false},
    "cluster_proteins": {"type": "boolean", "default": false, "description": "Cluster protein evidence before BRAKER"},
    "cluster_min_seq_id": {"type": "number", "default": 0.9, "minimum": 0, "maximum": 1},
    "cluster_coverage": {"type": "number", "default": 0.8, "exclusiveMinimum": 0, "maximum": 1},
    "busco_lineage": {"type": "string", "default": "poales_odb10"},
    "busco_db": {"type": "string"},
    "multiqc_container": {"type": "string", "default": "quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0", "description": "Container used for annotation MultiQC reports"},
    "edta_species": {"type": "string", "default": "others"},
    "edta_db": {"type": "string"},
    "repeatmasker_library": {"type": "string"},
    "interproscan": {"type": "boolean", "default": false},
    "interproscan_db": {"type": "string"},
    "eggnog": {"type": "boolean", "default": false},
    "eggnog_db": {"type": "string"},
    "run_edta": {"type": "boolean", "default": true},
    "run_repeatmasker": {"type": "boolean", "default": true},
    "min_contig_size": {"type": "integer", "default": 5000, "minimum": 0},
    "max_cpus": {"type": "integer", "default": 32, "minimum": 1},
    "max_memory": {"type": "string", "default": "128.GB"},
    "max_time": {"type": "string", "default": "7.day"}
  },
  "required": ["input", "proteins"]
}
